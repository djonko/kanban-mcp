# Copy to .env and fill in. Consumed by docker-compose (`npm run up`) and the
# MCP server. Generate a strong signing key with: openssl rand -hex 64

# --- Planka container (docker-compose.yml) ---
PLANKA_PORT=3333
BASE_URL=http://localhost:3333
TRUST_PROXY=1
SECRET_KEY=change-me-run-openssl-rand-hex-64

# Postgres (docker-compose.yml)
POSTGRES_DB=planka
POSTGRES_USER=planka
POSTGRES_PASSWORD=change-me

# Default admin, seeded by Planka on first boot
PLANKA_ADMIN_EMAIL=demo@demo.demo
PLANKA_ADMIN_PASSWORD=change-me
PLANKA_ADMIN_NAME=Demo Admin
PLANKA_ADMIN_USERNAME=demo

# --- MCP server (kanban-mcp) ---
PLANKA_BASE_URL=http://localhost:3333
PLANKA_AGENT_EMAIL=demo@demo.demo
PLANKA_AGENT_PASSWORD=change-me
# Optional OIDC token destination. Defaults to the platform config directory;
# persisted OIDC tokens are not yet consumed by normal MCP requests.
# PLANKA_TOKEN_FILE=
# Optional: provide the admin user ID directly to skip the user lookup.
# PLANKA_ADMIN_ID=
